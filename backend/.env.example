# ─────────────────────────────────────────
# JobPulse – Environment Variables
# Copy this file to .env and fill in values
# ─────────────────────────────────────────

# Server
PORT=3000

# MongoDB Atlas URI (replace <username> and <password> with your Atlas credentials)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/jobpulse?retryWrites=true&w=majority

# ─────────────────────────────────────────
# AI Provider  (groq | gemini | openai | anthropic)
# ─────────────────────────────────────────
AI_PROVIDER=groq

# Groq API (Free key from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# OpenAI (uncomment when switching provider)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Anthropic (uncomment when switching provider)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-haiku-20240307

# ─────────────────────────────────────────
# Business Rules
# ─────────────────────────────────────────

# How many hours before job data is considered stale
DATA_FRESHNESS_HOURS=1

# Company refresh cron interval (in minutes)
REFRESH_INTERVAL_MINUTES=60

# Polite delay between HTTP requests (ms)
SCRAPE_DELAY_MS=2000
